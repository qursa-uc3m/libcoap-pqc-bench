#!/bin/bash
# =============================================================================
# config.env - Central configuration for libcoap-pqc-bench
# =============================================================================
# This file contains default values for all environment-specific settings.
# 
# To customize for your environment:
#   1. Copy this file to config.local.env
#   2. Edit config.local.env with your values
#   3. config.local.env is git-ignored and will override these defaults
#
# Alternatively, set environment variables before running scripts:
#   export RASPBERRY_PI_IP="10.0.0.100"
#   ./benchmark/coap_benchmark.sh ...
# =============================================================================

# -----------------------------------------------------------------------------
# LOCAL MODE CONFIGURATION
# -----------------------------------------------------------------------------
# Set to "true" for local benchmarking without Raspberry Pi
# Set to "false" for Raspberry Pi mode
LOCAL_MODE="${LOCAL_MODE:-true}"

# Enable energy measurement (set to "true" to measure energy)
MEASURE_ENERGY="${MEASURE_ENERGY:-true}"

# Energy monitor type: "codecarbon" (local), "fnirsi" (USB meter), or "none"
ENERGY_MONITOR_TYPE="${ENERGY_MONITOR_TYPE:-codecarbon}"

# Local server address (IPv6 loopback)
LOCAL_SERVER_ADDRESS="${LOCAL_SERVER_ADDRESS:-::1}"

# Network interface for packet capture in local mode
LOCAL_CAPTURE_INTERFACE="${LOCAL_CAPTURE_INTERFACE:-lo}"

# -----------------------------------------------------------------------------
# PERF COMMAND CONFIGURATION
# -----------------------------------------------------------------------------
# Perf command for local mode (use system perf)
PERF_CMD="${PERF_CMD:-perf}"

# Perf command for Raspberry Pi (custom build for kernel 5.10)
PERF_CMD_RPI="${PERF_CMD_RPI:-perf_5.10}"

# -----------------------------------------------------------------------------
# RASPBERRY PI (CoAP Server) CONFIGURATION
# -----------------------------------------------------------------------------
RASPBERRY_PI_IP="${RASPBERRY_PI_IP:-192.168.0.157}"
RASPBERRY_PI_USER="${RASPBERRY_PI_USER:-root}"
RASPBERRY_PI_PATH="${RASPBERRY_PI_PATH:-~/libcoap-pqc-bench}"

# -----------------------------------------------------------------------------
# NETWORK EMULATION VM CONFIGURATION
# -----------------------------------------------------------------------------
VM_IP="${VM_IP:-192.168.0.172}"
VM_USER="${VM_USER:-ubuntu}"
VM_INTERFACE="${VM_INTERFACE:-ens3}"

# -----------------------------------------------------------------------------
# CLIENT HOST CONFIGURATION
# -----------------------------------------------------------------------------
CLIENT_IP="${CLIENT_IP:-192.168.0.228}"

# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
NETWORK_RANGE="${NETWORK_RANGE:-192.168.0.0/24}"
BRIDGE_INTERFACE="${BRIDGE_INTERFACE:-br0}"

# -----------------------------------------------------------------------------
# COAP PORTS (standard values, rarely need changing)
# -----------------------------------------------------------------------------
COAP_PORT="${COAP_PORT:-5683}"
COAPS_PORT="${COAPS_PORT:-5684}"

# -----------------------------------------------------------------------------
# TIMING CONFIGURATION (seconds)
# -----------------------------------------------------------------------------
# Smart checks poll every 0.1s with these values as max timeout.
# Works for both local and remote (via SSH) modes.

# Port/server lifecycle (smart checks: wait_for_port_free/listen, wait_for_process_exit)
TIMING_PORT_RELEASE_LOCAL="${TIMING_PORT_RELEASE_LOCAL:-2.0}"
TIMING_PORT_RELEASE_REMOTE="${TIMING_PORT_RELEASE_REMOTE:-1.0}"
TIMING_SERVER_START_LOCAL="${TIMING_SERVER_START_LOCAL:-3.0}"
TIMING_SERVER_START_REMOTE="${TIMING_SERVER_START_REMOTE:-3.0}"
TIMING_TSHARK_FLUSH_LOCAL="${TIMING_TSHARK_FLUSH_LOCAL:-3.0}"
TIMING_TSHARK_FLUSH_REMOTE="${TIMING_TSHARK_FLUSH_REMOTE:-2.0}"
TIMING_SERVER_STOP_LOCAL="${TIMING_SERVER_STOP_LOCAL:-2.0}"
TIMING_SERVER_STOP_REMOTE="${TIMING_SERVER_STOP_REMOTE:-3.0}"

# Energy monitoring
TIMING_ENERGY_SIGNAL="${TIMING_ENERGY_SIGNAL:-0.5}"
TIMING_ENERGY_FLUSH="${TIMING_ENERGY_FLUSH:-1.0}"

# Client operations
TIMING_CLIENT_DELAY="${TIMING_CLIENT_DELAY:-0.5}"
TIMING_CLIENT_POLL="${TIMING_CLIENT_POLL:-0.1}"

# Retry/pause between runs
TIMING_RETRY_LOCAL="${TIMING_RETRY_LOCAL:-2.0}"
TIMING_RETRY_REMOTE="${TIMING_RETRY_REMOTE:-5.0}"
TIMING_PAUSE_BETWEEN_RUNS_LOCAL="${TIMING_PAUSE_BETWEEN_RUNS_LOCAL:-0.3}"
TIMING_PAUSE_BETWEEN_RUNS_REMOTE="${TIMING_PAUSE_BETWEEN_RUNS_REMOTE:-10}"